{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "buildCommand": "cd ../frontend && npm ci && npm run build && cd ../backend && rm -rf public && cp -r ../frontend/dist public",
  "functions": {
    "app/main.py": {
      "maxDuration": 30,
      "includeFiles": "public/index.html",
      "excludeFiles": "{tests/**,alembic/**,.venv/**,.pytest_cache/**,*.db,app/seeds/**,public/assets/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
