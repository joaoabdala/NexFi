# Banco de dados
# Produção/desenvolvimento com Docker: postgresql+psycopg://nexfi:nexfi@localhost:5432/nexfi
# Dev local sem Postgres instalado: sqlite:///./dev.db
# Neon: cole a connection string *pooled* como está (postgresql://...-pooler...?sslmode=require);
# o driver psycopg é aplicado automaticamente. Ver docs/DEPLOY.md.
DATABASE_URL=postgresql+psycopg://nexfi:nexfi@localhost:5432/nexfi

# Segurança
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (separado por vírgula)
CORS_ORIGINS=http://localhost:5173
# Opcional: regex para origens dinâmicas (ex.: previews da Vercel)
CORS_ORIGIN_REGEX=

# Aplicação
APP_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
DEFAULT_LOCALE=pt-BR
RECURRENCE_HORIZON_MONTHS=3

# Seed
SEED_ADMIN_EMAIL=demo@abdalanexus.com
SEED_ADMIN_PASSWORD=demo123
SEED_ADMIN_NAME=Usuário Demo

ENVIRONMENT=development
